[Unit]
Description=HomeCore OS firewall (nftables table inet homecore)
Documentation=file:///opt/homecore/docs/NETWORKING.md
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
After=local-fs.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/homecore/firewall.nft
ExecReload=/usr/sbin/nft -f /etc/homecore/firewall.nft
ExecStop=-/usr/sbin/nft delete table inet homecore

[Install]
WantedBy=sysinit.target
