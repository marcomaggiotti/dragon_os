# HomeCore OS — stack settings (copied to /opt/homecore/.env by the installer)
TZ=UTC

# Image tags. "stable"/"2"/"latest" follow upstream; pin exact versions for reproducibility.
HA_VERSION=stable
MOSQUITTO_VERSION=2
Z2M_VERSION=latest

# Memory ceilings — sized for a 1 GB Raspberry Pi 3B. Raise them on bigger hosts/VMs.
HA_MEM_LIMIT=640m
MOSQUITTO_MEM_LIMIT=48m
Z2M_MEM_LIMIT=256m

# Unprivileged user that runs Zigbee2MQTT; DIALOUT_GID grants access to the USB dongle.
HC_UID=1000
HC_GID=1000
DIALOUT_GID=20

# Zigbee coordinator — set automatically by: homecore zigbee enable
#   ZBDongle-P (CC2652P)  -> ZIGBEE_ADAPTER=zstack
#   ZBDongle-E (EFR32MG21) -> ZIGBEE_ADAPTER=ember
ZIGBEE_DEVICE=
ZIGBEE_ADAPTER=zstack

# Optional services. "zigbee" starts Zigbee2MQTT.
COMPOSE_PROFILES=
